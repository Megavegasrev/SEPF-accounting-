# =============================================================================
# SEPF Treasury — environment configuration (copy to .env.local)
# =============================================================================

# --- Database -----------------------------------------------------------------
# The application connects with ONE login role and switches privilege per request
# via `SET LOCAL ROLE app_user|service_role`. In production this role must be a
# least-privilege login role that is a MEMBER of app_user and service_role
# (never a superuser) — see db/deploy/00_app_login_role.sql.example.
# Either set DATABASE_URL, or the discrete PG* variables below.
DATABASE_URL=postgres://sepf_app:CHANGE_ME@localhost:5432/sepf
# PGHOST=/var/run/postgresql
# PGPORT=5432
# PGUSER=sepf_app
# PGPASSWORD=CHANGE_ME
# PGDATABASE=sepf

# --- Sessions -----------------------------------------------------------------
# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
SESSION_COOKIE_NAME=sepf_session
SESSION_TTL_MINUTES=60

# --- Storage (supporting documents) ------------------------------------------
# local (dev) | s3 | supabase. Files are private; access is via short-lived URLs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# --- App ----------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
